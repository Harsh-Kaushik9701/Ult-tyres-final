# ---------------------------------------------------------------------------
# Ultimate Tyres – environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit real secrets. .env* files are git-ignored.
# ---------------------------------------------------------------------------

# Public site URL – used for canonical links, og:url/og:image, sitemap and robots.
# For local testing use http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://ultimatetyres.com.au

# MongoDB connection (optional for local testing – the site falls back to
# built-in catalogue/locations data when this is empty or unreachable).
MONGODB_URI=
MONGODB_DB=ultimate_tyres
# How long to wait for the database before falling back (ms)
MONGODB_TIMEOUT_MS=4000

# REQUIRED in production: a long random value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Contact & helpline details
NEXT_PUBLIC_PHONE=1300 110 002
NEXT_PUBLIC_WHATSAPP=61482094850

# Local-only demo logins (dealer@ultimatetyres.com.au / admin@ultimatetyres.com.au).
# Ignored in production builds (`next build && next start`). Leave false on any shared server.
ENABLE_DEMO_LOGIN=false
DEMO_DEALER_PASSWORD=dealer123
DEMO_ADMIN_PASSWORD=admin123

# Optional initial admin user to seed via `npm run db:setup`
BOOTSTRAP_ADMIN_EMAIL=admin@ultimatetyres.com.au
BOOTSTRAP_ADMIN_PASSWORD=
